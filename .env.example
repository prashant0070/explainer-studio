# OpenAI-compatible chat API (the ONLY paid thing — required for new scripts)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL and FREE. The full video pipeline works with
# just the LLM key: voiceover (edge-tts), images (Pollinations), captions,
# editing and QC (FFmpeg) cost nothing.
# ---------------------------------------------------------------------------

# Override the default narrator (any edge-tts voice name)
TTS_VOICE=

# Free stock-footage keys (both have free tiers, no card needed).
# With a key set, scenes use real video clips instead of Ken Burns stills.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Paid image generation (optional). If set, "Generate 8 images" uses it;
# otherwise the app uses the free Pollinations generator automatically.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
