# OpenAI-compatible chat API (required for new scripts)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Image generation (optional — prompts are always created)
# OpenAI Images: dall-e-3 or gpt-image-1
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

# If IMAGE_API_KEY is empty, the app reuses LLM_API_KEY for images.
